{
  "name": "@local/dsh-attention-notify",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Global attention notifications for DeepSeek Harness: sound + floating cards when a session finishes or needs your approval/answer, across every workspace.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "overlay/attention-overlay.ps1",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
